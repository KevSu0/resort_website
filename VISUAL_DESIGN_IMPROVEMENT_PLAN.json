  "microInteractions": {
    "buttons": {
      "hover": {
        "transform": "translateY(-2px)",
        "boxShadow": "0 10px 20px rgba(0,0,0,0.1)",
        "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "active": {
        "transform": "translateY(0)",
        "boxShadow": "0 5px 10px rgba(0,0,0,0.1)",
        "transition": "all 0.1s ease-out"
      },
      "focus": {
        "outline": "2px solid #3b82f6",
        "outlineOffset": "2px"
      },
      "loading": {
        "opacity": "0.7",
        "cursor": "not-allowed",
        "animation": "pulse 2s infinite"
      }
    },
    "cards": {
      "hover": {
        "transform": "scale(1.02) translateY(-4px)",
        "boxShadow": "0 20px 40px rgba(0,0,0,0.15)",
        "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "imageHover": {
        "transform": "scale(1.1)",
        "transition": "transform 0.5s ease"
      }
    },
    "formFields": {
      "focus": {
        "borderColor": "#3b82f6",
        "boxShadow": "0 0 0 3px rgba(59, 130, 246, 0.1)",
        "transform": "scale(1.01)",
        "transition": "all 0.2s ease"
      },
      "error": {
        "borderColor": "#ef4444",
        "boxShadow": "0 0 0 3px rgba(239, 68, 68, 0.1)",
        "animation": "shake 0.5s ease-in-out"
      }
    },
    "navigation": {
      "itemHover": {
        "color": "#3b82f6",
        "borderBottom": "2px solid #3b82f6",
        "transition": "all 0.2s ease"
      },
      "mobileMenu": {
        "animation": "slideIn 0.3s ease-out"
      }
    },
    "loading": {
      "skeleton": {
        "background": "linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%)",
        "backgroundSize": "200% 100%",
        "animation": "shimmer 1.5s infinite"
      },
      "spinner": {
        "borderColor": "#e5e7eb",
        "borderTopColor": "#3b82f6",
        "animation": "spin 1s linear infinite"
      }
    }
  },

  "componentDesignSystem": {
    "buttons": {
      "primary": {
        "backgroundColor": "#3b82f6",
        "color": "#ffffff",
        "padding": "12px 24px",
        "borderRadius": "8px",
        "fontWeight": "600",
        "fontSize": "16px",
        "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "secondary": {
        "backgroundColor": "transparent",
        "color": "#3b82f6",
        "border": "2px solid #3b82f6",
        "padding": "12px 24px",
        "borderRadius": "8px",
        "fontWeight": "600",
        "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "ghost": {
        "backgroundColor": "transparent",
        "color": "#6b7280",
        "padding": "8px 16px",
        "borderRadius": "6px",
        "transition": "all 0.2s ease"
      }
    },
    "cards": {
      "property": {
        "borderRadius": "16px",
        "overflow": "hidden",
        "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
        "transition": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)",
        "backgroundColor": "#ffffff"
      },
      "testimonial": {
        "borderRadius": "12px",
        "padding": "24px",
        "backgroundColor": "#f9fafb",
        "borderLeft": "4px solid #3b82f6"
      }
    },
    "inputs": {
      "text": {
        "borderRadius": "8px",
        "border": "2px solid #e5e7eb",
        "padding": "12px 16px",
        "fontSize": "16px",
        "transition": "all 0.2s ease",
        "focus": {
          "borderColor": "#3b82f6",
          "boxShadow": "0 0 0 3px rgba(59, 130, 246, 0.1)"
        }
      },
      "search": {
        "borderRadius": "50px",
        "padding": "16px 24px",
        "fontSize": "16px",
        "border": "none",
        "boxShadow": "0 4px 20px rgba(0,0,0,0.1)"
      }
    }
  },

  "layoutGrid": {
    "container": {
      "maxWidth": {
        "sm": "640px",
        "md": "768px",
        "lg": "1024px",
        "xl": "1280px",
        "2xl": "1400px"
      },
      "padding": {
        "mobile": "16px",
        "tablet": "24px",
        "desktop": "32px"
      }
    },
    "grid": {
      "columns": 12,
      "gap": {
        "sm": "16px",
        "md": "24px",
        "lg": "32px"
      }
    }
  },

  "animationGuidelines": {
    "timingFunctions": {
      "easeOut": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "easeIn": "cubic-bezier(0.55, 0.055, 0.675, 0.19)",
      "easeInOut": "cubic-bezier(0.645, 0.045, 0.355, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    },
    "durations": {
      "fast": "0.15s",
      "normal": "0.3s",
      "slow": "0.5s",
      "slower": "0.75s"
    },
    "keyframes": {
      "fadeIn": "opacity: 0; to { opacity: 1; }",
      "slideUp": "transform: translateY(20px); opacity: 0; to { transform: translateY(0); opacity: 1; }",
      "scaleIn": "transform: scale(0.95); opacity: 0; to { transform: scale(1); opacity: 1; }",
      "shimmer": "background-position: 200% 0; to { background-position: -200% 0; }",
      "spin": "transform: rotate(0deg); to { transform: rotate(360deg); }",
      "shake": "0%, 100% { transform: translateX(0); } 25% { transform: translateX(-10px); } 75% { transform: translateX(10px); }"
    }
  },

