// DB-009-5: Anomaly detection and alerting
model SystemAnomaly {
  id           String   @id @default(cuid())
  siteId       String?
  service      String?
  metricType   AnomalyMetricType
  metricName   String
  anomalyType  AnomalyType
  severity     AnomalySeverity @default(MEDIUM)

  // Anomaly details
  currentValue Float?   // Current metric value
  expectedValue Float?  // Expected value
  threshold    Float?   // Threshold that was breached
  deviation    Float?   // Deviation from expected
  confidence   Float?   // Confidence score 0-1

  // Context
  context      Json?    // Additional context information
  patterns     Json?    // Detected patterns
  correlations Json?    // Correlated anomalies

  // Time information
  detectedAt   DateTime @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Int?     // Duration in minutes

  // Alert status
  status       AnomalyStatus @default(ACTIVE)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  resolution     String?

  // Impact assessment
  impactLevel  ImpactLevel @default(LOW)
  affectedServices String[] // Services affected
  affectedUsers Int?        // Number of affected users

  // Response actions
  autoResponse  Boolean  @default(false)
  responseActions Json?   // Actions taken
  escalationTriggered Boolean @default(false)

  // Learning and improvement
  falsePositive Boolean  @default(false)
  feedbackScore Float?   // Feedback score for accuracy
  improvementSuggestions Json?

  // Metadata
  metadata     Json?
  tags         String[]

  @@index([siteId])
  @@index([service])
  @@index([metricType])
  @@index([anomalyType])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@index([acknowledgedAt])
  @@index([resolvedAt])
  @@index([impactLevel])
  @@index([falsePositive])
  // Performance indexes for anomaly tracking
  @@index([siteId, severity, status, detectedAt(sort: Desc)]) // Active anomalies by severity
  @@index([service, anomalyType, detectedAt(sort: Desc)]) // Service anomaly patterns
  @@index([metricType, metricName, detectedAt(sort: Desc)]) // Metric anomaly history
  @@index([status, detectedAt(sort: Desc)]) // Anomaly status tracking
  @@index([tags], map: "idx_system_anomaly_tags") // GIN index for tags
  @@map("system_anomalies")
}

model AnalyticsEvent {
