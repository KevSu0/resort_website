{
  "name": "resort-admin-backend",
  "version": "1.0.0",
  "description": "Backend API for Resort Admin Panel",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=../prisma/schema.prisma",
    "db:seed": "tsx ../prisma/seed.ts",
    "db:studio": "prisma studio --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@types/archiver": "^6.0.3",
    "@types/multer": "^2.0.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exif-parser": "^0.1.12",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.0",
    "magic-bytes.js": "^1.12.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cryptex": "^0.0.2",
    "pdf-parse": "^1.1.1",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.34.4",
    "winston": "^3.18.3",
    "zip-stream": "^7.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  },
  "keywords": [
    "resort",
    "admin",
    "backend",
    "api",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Resort Management System",
  "license": "MIT"
}
