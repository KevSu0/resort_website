{
  "extends": "./typescript/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/config/*": ["./config/*"],
      "@/assets/*": ["./assets/*"],
      "@/docs/*": ["./docs/*"]
    }
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "build/dist",
    "tests/coverage"
  ]
}